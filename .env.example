# Variáveis do servidor (server/), que serve o app e cuida do login do Google
# Drive. Copie para .env.local e preencha; o `npm start` lê esse arquivo. No
# Coolify, cadastre as mesmas variáveis no app, como variáveis de execução.
# Sem as quatro primeiras, o app funciona normalmente, só sem o botão do Drive.

# OAuth Client ID do tipo "Aplicativo da Web", criado no Google Cloud Console
# (APIs e serviços → Credenciais).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chave que cifra o cookie do login: 32 bytes aleatórios em base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
COOKIE_SECRET=

# Origens de onde o app é aberto: exatas, sem barra no fim, separadas por
# vírgula. Cada uma precisa do redirect <origem>/api/auth/callback cadastrado
# no Client ID.
OAUTH_ALLOWED_ORIGINS=http://localhost:3000

# Opcional: porta do servidor (padrão 3000).
# PORT=3000
